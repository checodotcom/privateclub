<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} — privateclub</title>
  <link rel="stylesheet" href="/css/win95.css" />
  <link rel="icon" type="image/png" href="/img/pc-logo-corto.png" />
  <script>
    // Pages rendered inside a desktop window (iframe) drop the OS chrome.
    if (window.top !== window.self) document.documentElement.classList.add('is-embedded');
  </script>

  <meta property="og:title" content="{{ title }} — privateclub" />
  <meta property="og:description" content="{{ excerpt or 'Selecciones musicales para escuchas activas e íntimas.' }}" />
  <meta property="og:image" content="https://checoprivateclub.netlify.app/img/logo-white.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://checoprivateclub.netlify.app{{ page.url }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }} — privateclub" />
  <meta name="twitter:description" content="{{ excerpt or 'Selecciones musicales para escuchas activas e íntimas.' }}" />
  <meta name="twitter:image" content="https://checoprivateclub.netlify.app/img/logo-white.png" />
</head>
<body>
{% set section = "" %}
{% if page.url == "/home/" %}{% set section = "home" %}
{% elif page.url == "/posts/" or page.url.startsWith("/posts/") %}{% set section = "posts" %}
{% elif page.url == "/albumes/" %}{% set section = "albumes" %}
{% elif page.url == "/selecciones/" %}{% set section = "selecciones" %}
{% elif page.url == "/about/" %}{% set section = "about" %}
{% elif page.url == "/mensajes/" %}{% set section = "mensajes" %}
{% endif %}

{% if desktop %}
  <!-- DESKTOP HOME: wallpaper + icons + centered logo -->
  <div class="desktop-home">
    {% include "desktop-icons.njk" %}
    <main class="desktop-hero">
      {{ content | safe }}
    </main>
    <!-- Open windows are created here by /js/desktop.js -->
    <div class="desktop-windows" id="desktop-windows"></div>
  </div>
{% else %}
  <div class="desktop">

    {% include "desktop-icons.njk" %}

    <!-- SITE HEADER -->
    <div class="window site-header-window">
      <div class="window-titlebar">
        <span>🎵 privateclub — escuchas reposadas</span>
        <div class="titlebar-controls">
          <input type="checkbox" id="site-window-minimize" class="window-toggle window-minimize sr-only">
          <label for="site-window-minimize" class="titlebar-btn">_</label>
          <input type="checkbox" id="site-window-maximize" class="window-toggle window-maximize sr-only">
          <label for="site-window-maximize" class="titlebar-btn">□</label>
          <a href="/" class="titlebar-btn">✕</a>
        </div>
      </div>
      <div class="window-content">
        <div class="site-hero">
          <img class="site-logo" src="/img/logo.png" alt="private club" />
          <div>
            <div class="site-tagline">// selecciones musicales para escuchas activas e íntimas //</div>
            <div class="site-tagline" style="margin-top:4px;color:#808080;">curaduría personal desde las profundidades de la web</div>
          </div>
        </div>
      </div>
    </div>

    <!-- GRID: sidebar + main -->
    <div class="desktop-grid{% if page.url != '/' and not filterable %} desktop-grid--nav-last{% endif %}{% if section != 'about' and not filterable %} desktop-grid--solo{% endif %}">

      <!-- SIDEBAR -->
      {% if section == "about" or filterable %}<aside>
        <div class="window sidebar-window">
          <div class="window-titlebar">
            {% if section == "about" %}<span>📁 Contacto</span>
            {% else %}<span class="app-title"><img class="titlebar-icon" src="/img/icons/etiquetas.svg" alt="" width="16" height="16" /> Etiquetas</span>{% endif %}
          </div>
          <div class="window-content">
            {% if section == "about" %}
            <div class="sidebar-section">
              <div class="contact-buttons">
                {% if contacto.instagram %}<a class="btn" href="{{ contacto.instagram }}" target="_blank" rel="noopener"><img src="/img/icons/instagram.svg" alt="" width="24" height="24" />Instagram</a>{% endif %}
                {% if contacto.spotify %}<a class="btn" href="{{ contacto.spotify }}" target="_blank" rel="noopener"><img src="/img/icons/spotify.svg" alt="" width="24" height="24" />Spotify</a>{% endif %}
                {% if contacto.email %}<a class="btn" href="mailto:{{ contacto.email }}"><img src="/img/icons/correo.svg" alt="" width="24" height="24" />Correo</a>{% endif %}
              </div>
            </div>
            {% else %}
            <div class="tag-list">
              {% for tag in collections.tagList %}
                <button type="button" class="tag tag-filter" data-tag="{{ tag }}" aria-pressed="false">{{ tag | tagLabel }}</button>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
      </aside>{% endif %}

      <!-- MAIN CONTENT -->
      <main>
        {{ content | safe }}
      </main>

    </div>
  </div>
{% endif %}

  <!-- START MENU: suggestion form (Netlify Forms) -->
  <div class="start-menu" id="start-menu" hidden>
    <div class="start-menu-banner" aria-hidden="true"><span>private<i>club</i></span></div>
    <form class="start-form" name="sugerencias" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
      <input type="hidden" name="form-name" value="sugerencias" />
      <p class="sr-only"><label>No llenar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="start-form-title">
        <img src="/img/icons/sugerencia.svg" alt="" width="16" height="16" />
        Enviar sugerencia
      </div>
      <label class="form-row">
        <span>Nombre</span>
        <input class="win-input" type="text" name="nombre" maxlength="80" required autocomplete="name" />
      </label>
      <label class="form-row">
        <span>Email</span>
        <input class="win-input" type="email" name="email" maxlength="120" required autocomplete="email" />
      </label>
      <label class="form-row">
        <span>Sugerencia</span>
        <textarea class="win-input" name="sugerencia" rows="3" maxlength="300" required placeholder="Ej. nombre de un artista o álbum"></textarea>
        <small class="form-hint">Solo nombres, sin links.</small>
      </label>
      <label class="win-check">
        <input type="checkbox" name="acepto" value="si" required />
        <span class="win-check-box" aria-hidden="true"></span>
        Acepto compartir mis datos
      </label>
      <p class="form-status" role="status" aria-live="polite"></p>
      <div class="form-actions">
        <button type="submit" class="btn">Enviar</button>
      </div>
    </form>
  </div>

  <!-- Success dialog shown after sending a suggestion -->
  <div class="win-dialog-backdrop" id="sent-dialog" hidden>
    <div class="window win-dialog" role="alertdialog" aria-modal="true" aria-labelledby="sent-dialog-title" aria-describedby="sent-dialog-msg">
      <div class="window-titlebar">
        <span id="sent-dialog-title">Envío exitoso</span>
        <div class="titlebar-controls">
          <button type="button" class="titlebar-btn" data-close aria-label="Cerrar">✕</button>
        </div>
      </div>
      <div class="win-dialog-body">
        <img src="/img/icons/ok.svg" alt="" width="32" height="32" />
        <p id="sent-dialog-msg">Gracias por el envío de sugerencia.</p>
      </div>
      <div class="win-dialog-actions">
        <button type="button" class="btn" data-close>Ok</button>
      </div>
    </div>
  </div>

  <!-- TASKBAR -->
  <div class="taskbar">
    <button type="button" class="start-btn" id="start-btn" aria-haspopup="true" aria-expanded="false" aria-controls="start-menu">
      <img class="start-icon" src="/img/icons/sugerencia.svg" alt="" width="20" height="20" />
      Sugerencia
    </button>
    <span class="taskbar-sep" aria-hidden="true"></span>
    <div class="taskbar-windows" id="taskbar-windows">
      {% if not desktop %}
        <span class="taskbar-current">
          {% if section %}<img src="/img/icons/{{ section }}.svg" alt="" width="16" height="16" />{% endif %}
          {{ title }}
        </span>
      {% endif %}
    </div>
    <div class="taskbar-tray">
      <span class="tray-icon" aria-hidden="true">♪</span>
      <span class="taskbar-clock" id="clock">--:--</span>
    </div>
  </div>

  <script src="/js/desktop.js" defer></script>
  <script src="/js/start-menu.js" defer></script>
  {% if filterable %}<script src="/js/filter.js" defer></script>{% endif %}
  <script>
    // Live clock
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      document.getElementById('clock').textContent = h + ':' + m;
    }
    updateClock();
    setInterval(updateClock, 10000);
  </script>
</body>
</html>
