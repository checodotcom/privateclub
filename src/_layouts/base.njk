<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} — privateclub</title>
  <link rel="stylesheet" href="/css/win95.css" />
  <link rel="icon" type="image/png" href="/img/pc-logo-corto.png" />

  <meta property="og:title" content="{{ title }} — privateclub" />
  <meta property="og:description" content="{{ excerpt or 'Selecciones musicales para escuchas activas e íntimas.' }}" />
  <meta property="og:image" content="https://checoprivateclub.netlify.app/img/logo-white.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://checoprivateclub.netlify.app{{ page.url }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }} — privateclub" />
  <meta name="twitter:description" content="{{ excerpt or 'Selecciones musicales para escuchas activas e íntimas.' }}" />
  <meta name="twitter:image" content="https://checoprivateclub.netlify.app/img/logo-white.png" />
</head>
<body>

  <div class="desktop">

    <!-- SITE HEADER -->
    <div class="window site-header-window">
      <div class="window-titlebar">
        <span>🎵 privateclub — escuchas reposadas</span>
        <div class="titlebar-controls">
          <input type="checkbox" id="site-window-minimize" class="window-toggle window-minimize sr-only">
          <label for="site-window-minimize" class="titlebar-btn">_</label>
          <input type="checkbox" id="site-window-maximize" class="window-toggle window-maximize sr-only">
          <label for="site-window-maximize" class="titlebar-btn">□</label>
          <a href="/" class="titlebar-btn">✕</a>
        </div>
      </div>
      <div class="window-content">
        <div class="site-hero">
          <img class="site-logo" src="/img/logo.png" alt="private club" />
          <div>
            <div class="site-tagline">// selecciones musicales para escuchas activas e íntimas //</div>
            <div class="site-tagline" style="margin-top:4px;color:#808080;">curaduría personal desde las profundidades de la web</div>
          </div>
        </div>
      </div>
    </div>

    <!-- GRID: sidebar + main -->
    <div class="desktop-grid{% if page.url != '/' %} desktop-grid--nav-last{% endif %}">

      <!-- SIDEBAR -->
      <aside>
        <div class="window sidebar-window">
          <div class="window-titlebar">
            <span>📁 Navegación</span>
          </div>
          <div class="window-content">

            <div class="sidebar-section">
              <div class="sidebar-label">CARPETAS</div>
              <ul class="sidebar-links">
                <li><a href="/">🏠 Home</a></li>
                <li><a href="/posts/">📰 Todos los posts</a></li>
                <li><a href="/about/">👤 Acerca de</a></li>
              </ul>
            </div>

            <div class="sidebar-section">
              <div class="sidebar-label">GÉNEROS</div>
              <div class="tag-list">
                <a class="tag" href="/tags/ambient/">Ambient</a>
                <a class="tag" href="/tags/electronic/">Electronic</a>
                <a class="tag" href="/tags/jazz/">Jazz</a>
                <a class="tag" href="/tags/seleccion/">selecciones</a>
                <input type="checkbox" id="tags-more-toggle" class="tag-more-toggle" hidden>
                <label for="tags-more-toggle" class="tag-more-label tag-more-label-start">más...</label>
                <a class="tag tag-extra" href="/tags/post-punk/">Post-Punk</a>
                <a class="tag tag-extra" href="/tags/experimental/">Experimental</a>
                <a class="tag tag-extra" href="/tags/world/">World</a>
                <a class="tag tag-extra" href="/tags/noise/">Noise</a>
                <a class="tag tag-extra" href="/tags/downtempo/">Downtempo</a>
                <a class="tag tag-extra" href="/tags/trip-hop/">Trip-Hop</a>
                <label for="tags-more-toggle" class="tag-more-label tag-more-label-end">menos</label>
              </div>
            </div>

            <div class="sidebar-section">
              <div class="sidebar-label">AHORA SUENA</div>
              <div class="now-playing inset">
                <span>♪</span>
                <span class="np-track">{{ site.nowPlayingArtist }}<br>— {{ site.nowPlayingTrack }}</span>
              </div>
            </div>

            {% if site.socialLinks and site.socialLinks.length %}
            <div class="sidebar-section">
              <div class="sidebar-label">REDES</div>
              <ul class="sidebar-links">
                {% for link in site.socialLinks %}
                  <li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a></li>
                {% endfor %}
              </ul>
            </div>
            {% endif %}

            <div class="sidebar-section">
              <div class="sidebar-label">CONTADOR DE VISITAS</div>
              <div class="inset" style="font-size:14px;text-align:center;">
                <span style="color:#000080;font-size:20px;">00,001</span><br>
                visitas desde el lanzamiento
              </div>
            </div>

          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main>
        {{ content | safe }}
      </main>

    </div>
  </div>

  <!-- TASKBAR -->
  <div class="taskbar">
    <a href="/" class="start-btn">
      <span class="start-icon"></span>
      Start
    </a>
    {% if page.url != "/" %}
      <div class="taskbar-nav">
        <span class="taskbar-current">{{ title }}</span>
      </div>
    {% endif %}
    <div class="taskbar-clock" id="clock">--:--</div>
  </div>

  <script>
    // Live clock
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      document.getElementById('clock').textContent = h + ':' + m;
    }
    updateClock();
    setInterval(updateClock, 10000);
  </script>
</body>
</html>
