<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} — privateclub</title>
  <link rel="stylesheet" href="/css/win95.css" />
  <link rel="icon" type="image/png" href="/img/pc-logo-corto.png" />
  <script>
    // Pages rendered inside a desktop window (iframe) drop the OS chrome.
    if (window.top !== window.self) document.documentElement.classList.add('is-embedded');
  </script>

  <meta property="og:title" content="{{ title }} — privateclub" />
  <meta property="og:description" content="{{ excerpt or 'Selecciones musicales para escuchas activas e íntimas.' }}" />
  <meta property="og:image" content="https://checoprivateclub.netlify.app/img/logo-white.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://checoprivateclub.netlify.app{{ page.url }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }} — privateclub" />
  <meta name="twitter:description" content="{{ excerpt or 'Selecciones musicales para escuchas activas e íntimas.' }}" />
  <meta name="twitter:image" content="https://checoprivateclub.netlify.app/img/logo-white.png" />
</head>
<body>
{% set section = "" %}
{% if page.url == "/home/" %}{% set section = "home" %}
{% elif page.url == "/posts/" or page.url.startsWith("/posts/") %}{% set section = "posts" %}
{% elif page.url == "/albumes/" %}{% set section = "albumes" %}
{% elif page.url == "/selecciones/" %}{% set section = "selecciones" %}
{% elif page.url == "/about/" %}{% set section = "about" %}
{% endif %}

{% if desktop %}
  <!-- DESKTOP HOME: wallpaper + icons + centered logo -->
  <div class="desktop-home">
    {% include "desktop-icons.njk" %}
    <main class="desktop-hero">
      {{ content | safe }}
    </main>
    <!-- Open windows are created here by /js/desktop.js -->
    <div class="desktop-windows" id="desktop-windows"></div>
  </div>
{% else %}
  <div class="desktop">

    {% include "desktop-icons.njk" %}

    <!-- SITE HEADER -->
    <div class="window site-header-window">
      <div class="window-titlebar">
        <span>🎵 privateclub — escuchas reposadas</span>
        <div class="titlebar-controls">
          <input type="checkbox" id="site-window-minimize" class="window-toggle window-minimize sr-only">
          <label for="site-window-minimize" class="titlebar-btn">_</label>
          <input type="checkbox" id="site-window-maximize" class="window-toggle window-maximize sr-only">
          <label for="site-window-maximize" class="titlebar-btn">□</label>
          <a href="/" class="titlebar-btn">✕</a>
        </div>
      </div>
      <div class="window-content">
        <div class="site-hero">
          <img class="site-logo" src="/img/logo.png" alt="private club" />
          <div>
            <div class="site-tagline">// selecciones musicales para escuchas activas e íntimas //</div>
            <div class="site-tagline" style="margin-top:4px;color:#808080;">curaduría personal desde las profundidades de la web</div>
          </div>
        </div>
      </div>
    </div>

    <!-- GRID: sidebar + main -->
    <div class="desktop-grid{% if page.url != '/' %} desktop-grid--nav-last{% endif %}">

      <!-- SIDEBAR -->
      <aside>
        <div class="window sidebar-window">
          <div class="window-titlebar">
            <span>📁 Navegación</span>
          </div>
          <div class="window-content">

            {% if section == "about" %}
            <div class="sidebar-section">
              <div class="sidebar-label">CONTACTO</div>
              <div class="contact-buttons">
                {% if contacto.instagram %}<a class="btn" href="{{ contacto.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
                {% if contacto.spotify %}<a class="btn" href="{{ contacto.spotify }}" target="_blank" rel="noopener">Spotify</a>{% endif %}
                {% if contacto.email %}<a class="btn" href="mailto:{{ contacto.email }}">Correo</a>{% endif %}
              </div>
            </div>
            {% else %}
            <div class="sidebar-section">
              <div class="sidebar-label">GÉNEROS</div>
              {% set genresMain = [["ambient","Ambient"],["electronic","Electronic"],["jazz","Jazz"],["seleccion","selecciones"]] %}
              {% set genresExtra = [["post-punk","Post-Punk"],["experimental","Experimental"],["world","World"],["noise","Noise"],["downtempo","Downtempo"],["trip-hop","Trip-Hop"]] %}
              <div class="tag-list">
                {% for g in genresMain %}
                  {% if filterable %}<button type="button" class="tag tag-filter" data-tag="{{ g[0] }}" aria-pressed="false">{{ g[1] }}</button>
                  {% else %}<a class="tag" href="/tags/{{ g[0] }}/">{{ g[1] }}</a>{% endif %}
                {% endfor %}
                <input type="checkbox" id="tags-more-toggle" class="tag-more-toggle" hidden>
                <label for="tags-more-toggle" class="tag-more-label tag-more-label-start">más...</label>
                {% for g in genresExtra %}
                  {% if filterable %}<button type="button" class="tag tag-extra tag-filter" data-tag="{{ g[0] }}" aria-pressed="false">{{ g[1] }}</button>
                  {% else %}<a class="tag tag-extra" href="/tags/{{ g[0] }}/">{{ g[1] }}</a>{% endif %}
                {% endfor %}
                <label for="tags-more-toggle" class="tag-more-label tag-more-label-end">menos</label>
              </div>
            </div>

            <div class="sidebar-section">
              <div class="sidebar-label">AHORA SUENA</div>
              <div class="now-playing inset">
                <span>♪</span>
                <span class="np-track">{{ site.nowPlayingArtist }}<br>— {{ site.nowPlayingTrack }}</span>
              </div>
            </div>

            {% if site.socialLinks and site.socialLinks.length %}
            <div class="sidebar-section">
              <div class="sidebar-label">REDES</div>
              <ul class="sidebar-links">
                {% for link in site.socialLinks %}
                  <li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a></li>
                {% endfor %}
              </ul>
            </div>
            {% endif %}

            <div class="sidebar-section">
              <div class="sidebar-label">CONTADOR DE VISITAS</div>
              <div class="inset" style="font-size:14px;text-align:center;">
                <span style="color:#000080;font-size:20px;">00,001</span><br>
                visitas desde el lanzamiento
              </div>
            </div>

            {% endif %}

          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main>
        {{ content | safe }}
      </main>

    </div>
  </div>
{% endif %}

  <!-- TASKBAR -->
  <div class="taskbar">
    <a href="/" class="start-btn">
      <img class="start-icon" src="/img/icons/start.svg" alt="" width="20" height="20" />
      Start
    </a>
    <span class="taskbar-sep" aria-hidden="true"></span>
    <div class="taskbar-windows" id="taskbar-windows">
      {% if not desktop %}
        <span class="taskbar-current">
          {% if section %}<img src="/img/icons/{{ section }}.svg" alt="" width="16" height="16" />{% endif %}
          {{ title }}
        </span>
      {% endif %}
    </div>
    <div class="taskbar-tray">
      <span class="tray-icon" aria-hidden="true">♪</span>
      <span class="taskbar-clock" id="clock">--:--</span>
    </div>
  </div>

  <script src="/js/desktop.js" defer></script>
  {% if filterable %}<script src="/js/filter.js" defer></script>{% endif %}
  <script>
    // Live clock
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      document.getElementById('clock').textContent = h + ':' + m;
    }
    updateClock();
    setInterval(updateClock, 10000);
  </script>
</body>
</html>
