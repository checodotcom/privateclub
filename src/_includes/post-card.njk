<li class="post-card" data-tags="{% for t in post.data.tags %}{% if t != 'posts' %}{{ t }} {% endif %}{% endfor %}">
  <div class="post-card-header">
    <h2 class="post-card-title">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </h2>
    <span class="post-card-date">{{ post.date | dateFormat }}</span>
  </div>
  {% if post.data.tags %}
    <div class="post-card-tags">
      {% for tag in post.data.tags %}
        {% if tag != "posts" %}
          <a class="tag" href="/tags/{{ tag }}/">{{ tag }}</a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
  {% if post.data.excerpt %}
    <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
  {% endif %}
  <a href="{{ post.url }}" class="read-more">Leer más »</a>
</li>
