---
layout: base.njk
title: Home
permalink: /home/
---
<!-- HEADER BANNER -->
<div class="window home-banner" style="margin-bottom:12px;">
  <div class="window-titlebar">
    <span>🎵 privateclub — escuchas reposadas</span>
  </div>
  <div class="window-content">
    <div class="site-hero">
      <img class="site-logo" src="/img/logo.png" alt="private club" />
      <div>
        <div class="site-tagline">// selecciones musicales para escuchas activas e íntimas //</div>
        <div class="site-tagline" style="margin-top:4px;color:#808080;">curaduría personal desde las profundidades de la web</div>
      </div>
    </div>
  </div>
</div>

<!-- LATEST POSTS WINDOW -->
<div class="window" style="margin-bottom:12px;">
  <div class="window-titlebar">
    <span>📻 Más recientes</span>
    <div class="titlebar-controls">
      <input type="checkbox" id="home-recent-window-minimize" class="window-toggle window-minimize sr-only">
      <label for="home-recent-window-minimize" class="titlebar-btn">_</label>
      <input type="checkbox" id="home-recent-window-maximize" class="window-toggle window-maximize sr-only">
      <label for="home-recent-window-maximize" class="titlebar-btn">□</label>
    </div>
  </div>
  <div class="window-content">
    {% set recentPosts = collections.posts | limit(3) %}
    {% if recentPosts.length %}
      <ul class="post-list">
        {% for post in recentPosts %}
          {% include "post-card.njk" %}
        {% endfor %}
      </ul>
      <div style="margin-top:12px;">
        <a href="/posts/" class="btn btn-icon"><img src="/img/icons/posts.svg" alt="" width="16" height="16" />Ver todos los posts</a>
      </div>
    {% else %}
      <div class="inset" style="color:#808080;">Sin posts. Próximamente</div>
    {% endif %}
  </div>
</div>
