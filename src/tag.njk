---
layout: base.njk
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - posts
    - tagList
permalink: /tags/{{ tag }}/
eleventyComputed:
  title: "Tag: {{ tag }}"
---
<div class="window">
  <div class="window-titlebar">
    <span>🏷️ Tag: {{ tag }}</span>
    <div class="titlebar-controls">
      <input type="checkbox" id="tag-window-minimize" class="window-toggle window-minimize sr-only">
      <label for="tag-window-minimize" class="titlebar-btn">_</label>
      <input type="checkbox" id="tag-window-maximize" class="window-toggle window-maximize sr-only">
      <label for="tag-window-maximize" class="titlebar-btn">□</label>
      <a href="/tags/" class="titlebar-btn">✕</a>
    </div>
  </div>
  <div class="window-content">
    {% set taggedPosts = collections[tag] %}
    {% if taggedPosts and taggedPosts.length %}
      <ul class="post-list">
        {% for post in taggedPosts | reverse %}
          <li class="post-card">
            <div class="post-card-header">
              <h2 class="post-card-title">
                <a href="{{ post.url }}">{{ post.data.title }}</a>
              </h2>
              <span class="post-card-date">{{ post.date | dateFormat }}</span>
            </div>
            {% if post.data.tags %}
              <div class="post-card-tags">
                {% for t in post.data.tags %}
                  {% if t != "posts" %}
                    <a class="tag" href="/tags/{{ t }}/">{{ t }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            {% if post.data.excerpt %}
              <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
            {% endif %}
            <a href="{{ post.url }}" class="read-more">Leer más »</a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="inset" style="color:#808080;">No posts with this tag yet.</div>
    {% endif %}
    <div style="margin-top:12px;">
      <a href="/tags/" class="btn">← All Tags</a>
    </div>
  </div>
</div>
