---
layout: base.njk
title: Tags
permalink: /tags/
---
<div class="window">
  <div class="window-titlebar">
    <span>🏷️ Todos los tags</span>
  </div>
  <div class="window-content">
    <div class="tag-list" style="padding:8px;">
      {% for tag in collections.tagList %}
        <a class="tag" href="/tags/{{ tag }}/">{{ tag }}</a>
      {% endfor %}
    </div>
  </div>
</div>
