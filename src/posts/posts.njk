---
layout: base.njk
title: Todos los posts
permalink: /posts/
---
<div class="window">
  <div class="window-titlebar">
    <span>📰 Todos los posts ({{ collections.posts.length }})</span>
    <div class="titlebar-controls">
      <input type="checkbox" id="posts-window-minimize" class="window-toggle window-minimize sr-only">
      <label for="posts-window-minimize" class="titlebar-btn">_</label>
      <input type="checkbox" id="posts-window-maximize" class="window-toggle window-maximize sr-only">
      <label for="posts-window-maximize" class="titlebar-btn">□</label>
      <a href="/" class="titlebar-btn">✕</a>
    </div>
  </div>
  <div class="window-content">
    {% if collections.posts.length %}
      <ul class="post-list">
        {% for post in collections.posts %}
          <li class="post-card">
            <div class="post-card-header">
              <h2 class="post-card-title">
                <a href="{{ post.url }}">{{ post.data.title }}</a>
              </h2>
              <span class="post-card-date">{{ post.date | dateFormat }}</span>
            </div>
            {% if post.data.tags %}
              <div class="post-card-tags">
                {% for tag in post.data.tags %}
                  {% if tag != "posts" %}
                    <a class="tag" href="/tags/{{ tag }}/">{{ tag }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            {% if post.data.excerpt %}
              <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
            {% endif %}
            <a href="{{ post.url }}" class="read-more">Leer más »</a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="inset" style="color:#808080;">Sin posts. Próximamente</div>
    {% endif %}
  </div>
</div>
